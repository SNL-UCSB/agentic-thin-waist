# =============================================================================
# Agentic Thin Waist — environment configuration
# =============================================================================
#
# MINIMAL SETUP (everything else has a working default):
#
#   1. Copy this file:        cp .env.example .env
#   2. Paste your LLM key into ONE of:
#        ANTHROPIC_API_KEY=sk-ant-...        # Claude (default provider)
#        GOOGLE_API_KEY=AIza...              # Gemini — also set
#                                            #   ORCHESTRATOR_LLM_PROVIDER=gemini
#   3. (Optional) export it for the worker process too so wget/iperf3 can
#      authenticate with any LLM-driven workflow steps.
#
# That's it for `make up && make build`. The rest of this file is for tuning
# or enabling optional backends (AWS, LangSmith tracing, etc.) — leave the
# defaults alone unless you have a specific reason to change them.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Required: LLM provider keys
# -----------------------------------------------------------------------------
# Set ONE. Default provider is Anthropic; switch to Gemini by also setting
# ORCHESTRATOR_LLM_PROVIDER=gemini below.
ORCHESTRATOR_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Legacy alias for ANTHROPIC_API_KEY — services still read it; safe to leave blank.
CLAUDE_API_KEY=

# -----------------------------------------------------------------------------
# Shared infrastructure: Postgres + S3/MinIO
# -----------------------------------------------------------------------------
# Postgres is brought up by docker-compose under the `postgres` service.
DB_HOST=postgres
DB_NAME=telemetry
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_CONNECTION_TIMEOUT_SECONDS=5

# S3 is MinIO inside the compose network. Defaults work as-is for local dev.
S3_ENDPOINT_URL=http://minio:9000
NETGENT_S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET_NAME=telemetry
NETGENT_S3_BUCKET_NAME=netgent
S3_ACCESS_KEY=access-key
S3_SECRET_KEY=secret-key
S3_CONNECTION_RETRIES=3
S3_CONNECTION_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# NetGent service + Browserless (browser workflows)
# -----------------------------------------------------------------------------
NETGENT_USE_LOCAL=true
NETGENT_LLM_PROVIDER=gemini
NETGENT_HOST=0.0.0.0
NETGENT_PORT=8003
NETGENT_TIMEOUT_DEFAULT=30
BROWSERLESS_WS_ENDPOINT=ws://browserless:3000/chromium/playwright
BROWSER_POOL_SIZE=5
BROWSERLESS_PORT=3000
MAX_CONCURRENT_SESSIONS=5
QUEUE_LENGTH=100
BROWSERLESS_PROXY=
BRIGHTDATA_BROWSER_API=

# LangSmith tracing for NetGent — leave blank to disable.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=netgent-service

# -----------------------------------------------------------------------------
# CTP service (cross-traffic profiles)
# -----------------------------------------------------------------------------
CTP_DATABASE_URL=postgresql://admin:admin123@postgres:5432/telemetry
CTP_PORT=8001
CTP_LOG_LEVEL=INFO
CTP_WORKERS=4
CTP_WINDOW_DURATION_SEC=30
CTP_BURST_INTERVAL_MS=100
CTP_GATEWAY_SUBNET=169.231.0.0/16

# -----------------------------------------------------------------------------
# Substrate worker (traffic shaping, pcap capture)
# -----------------------------------------------------------------------------
CAPTURE_DIR=/home/netreplica/config/captures
CTP_DIR=/home/netreplica/config/ctp
CTP_OUTPUT_DIR=/home/netreplica/output_test

# -----------------------------------------------------------------------------
# Local CTP source (bypasses CTP_SERVICE_GLOBAL when enabled)
# -----------------------------------------------------------------------------
# Set ORCH_CTP_SOURCE=local_list to select background-traffic PCAPs from a
# local directory instead of querying the remote CTP service. Required layout:
#
#   <ORCH_LOCAL_CTP_ROOT>/
#     download/<ctp_name>.pcap
#     upload/<ctp_name>.pcap
#   <ORCH_LOCAL_CTP_LIST>   (a .txt or .json file listing available CTP names)
#
# .txt format  — one bare CTP base name per line (no .pcap extension), e.g.:
#   cluster0_tree0_profile862
#   cluster0_tree1_profile860
#
# .json format — list of objects with optional per-CTP intensity, e.g.:
#   [{"name": "cluster0_tree0_profile862", "mean_mbps": 6.2}, ...]
#   Entries without mean_mbps always pass the capacity-range filter.
#
# Also set ORCH_CTP_POINTER_MODE=local_path so the orchestrator hands the
# worker the pcap's absolute filesystem path (no HTTP download needed).
# The worker reads it from the bind-mounted SUBSTRATE_CTP_DIR directory.
ORCH_CTP_SOURCE=local_list
ORCH_LOCAL_CTP_ROOT=/mnt/md0/haarika
ORCH_LOCAL_CTP_LIST=/mnt/md0/haarika/ctps.txt
ORCH_LOCAL_CTP_SELECTION=first          # first (default) or random
ORCH_LOCAL_CTP_ALLOW_RANGE_FALLBACK=false  # true = use full list when no range match
ORCH_CTP_POINTER_MODE=local_path        # required in local_list mode

# -----------------------------------------------------------------------------
# Orchestration: /intent endpoint behaviour
# -----------------------------------------------------------------------------
# Default workflow-source policy for POST /intent when the request doesn't
# specify one. Per-request `workflow_source` always overrides this.
#   auto     — LLM picks from the library; fall back to generation if no match (default)
#   library  — LLM picks from the library only; fail loudly on no match
#   generate — skip the library, always generate
ORCH_DEFAULT_WORKFLOW_SOURCE=auto

# -----------------------------------------------------------------------------
# AWS backend (optional — leave commented for local Docker)
# -----------------------------------------------------------------------------
# Set CONNECTIVITY_BACKEND=aws to dispatch experiments to ephemeral EC2 workers
# instead of local Docker containers. With auto-provisioning on (default), the
# orchestrator creates the key pair, security group, and AMI on first use —
# just run `aws configure` first.
# CONNECTIVITY_BACKEND=aws
# AWS_REGION=us-west-2
# AWS_SUBSTRATE_ECR_URI=                     # Leave blank for auto-provisioning
# AWS_SUBSTRATE_SECURITY_GROUP=              # Leave blank for auto-provisioning
# AWS_SUBSTRATE_INSTANCE_TYPE=c5.xlarge
# AWS_SUBSTRATE_AUTO_PROVISION=true
# AWS_SUBSTRATE_KEY_PAIR=                    # Auto-created if blank
# AWS_SUBSTRATE_BOOT_TIMEOUT=300
# AWS_SUBSTRATE_IAM_PROFILE=                 # Optional IAM instance profile
