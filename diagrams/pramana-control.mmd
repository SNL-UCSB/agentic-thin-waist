graph TD
    USER(["User / Agent"])
    UI["pramana CLI - REST API"]

    subgraph ORCH["Core (one process at T1)"]
        IP["1 - Intent Parser (LLM binding)"]
        KB["2 - Knowledge Base<br/>hash-addressed capability snapshots"]
        MATCH["3 - Match (validation gate)"]
        PLAN["4 - Planner (rules)"]
        SPEC["5 - Spec Generator<br/>pins capability hashes + workflow shas"]
        SCHED["6 - Scheduler"]
    end

    subgraph PUBS["Static capability publishers (evolve independently)"]
        NG["NetGent registry<br/>capabilities.yaml, signed"]
        NR["NetReplica<br/>capabilities.yaml, signed"]
    end
    CTP["CTP Service<br/>capabilities: query schema, live"]
    CONN["Connectors<br/>local_docker, aws, ssh"]
    RDV["Channel<br/>T1 local / T2-T3 broker with pool"]
    POOL["Worker pool + service nodes"]

    USER --> UI --> IP --> MATCH
    KB --> MATCH
    MATCH -.->|"iterative backflow"| USER
    MATCH --> PLAN --> SPEC --> SCHED
    MATCH -->|"RUNTIME: CTP pointer query"| CTP
    KB -.->|"BOOTSTRAP + REFRESH:<br/>pull signed capability file"| NG
    KB -.->|"BOOTSTRAP + REFRESH:<br/>pull signed capability file"| NR
    KB -.->|"BOOTSTRAP + REFRESH:<br/>pull query schema"| CTP
    PLAN -->|"BOOTSTRAP: get_nodes / deploy"| CONN
    CONN -.->|"materialize pool + channel"| POOL
    CONN -.-> RDV
    SCHED -->|"offer work items"| RDV
    POOL -->|"claim + heartbeat (dial out)"| RDV
