{
  "specification": "test ndt workflow",
  "states": [
    {
      "checks": [
        {
          "type": "always_true",
          "params": {}
        }
      ],
      "actions": [
        {
          "type": "ndt",
          "params": {
            "download": "{{download}}",
            "upload": "{{upload}}"
          }
        }
      ]
    }
  ],
  "parameters": ["download", "upload"],
  "parameter_schema": {
    "download": {
      "type": "boolean",
      "default": true,
      "description": "Run the download direction of the NDT test (true/false)"
    },
    "upload": {
      "type": "boolean",
      "default": true,
      "description": "Run the upload direction of the NDT test (true/false)"
    }
  }
}
