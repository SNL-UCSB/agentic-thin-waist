#!/usr/bin/env bash
# =============================================================================
# config.env — netReplica Distributed Setup Configuration
# =============================================================================
#
# USAGE:
#   1. Copy this file: cp config.env.example config.env
#   2. Fill in values matching YOUR hardware (interface names, IPs, ports).
#   3. Each server only needs the variables for its own role, but keeping
#      all values in one file makes it easy to distribute to team members.
#
# TOPOLOGY (see Figure 4 in https://arxiv.org/pdf/2507.13476):
#
#   [Internet]
#       |
#   [Upstream Server]  -- switch port SWITCH_UPSTREAM_PORT  --+
#   [LibreQoS Server]  -- switch port SWITCH_LIBREQOS_PORT --[Switch]
#   [Downstream Server]-- switch port SWITCH_DOWNSTREAM_PORT -+
#                                                              |
#                                                  GRE tunnels to Pinot/clients
#
# The switch uses two VLANs to isolate upstream ↔ downstream traffic and
# force all flows through LibreQoS for shaping.
# =============================================================================


# -----------------------------------------------------------------------------
# UPSTREAM SERVER  (Edge Router / NAT gateway)
# Role: Receives traffic from downstream via the switch, NATs it to the internet.
# -----------------------------------------------------------------------------

# Network interface on the upstream server that is physically cabled to the switch.
UPSTREAM_SWITCH_IFACE="eno2"

# Network interface on the upstream server that is connected to the internet.
UPSTREAM_INTERNET_IFACE="eno1"

# IP address assigned to UPSTREAM_SWITCH_IFACE (must be reachable from LibreQoS).
UPSTREAM_SWITCH_IP="192.168.0.203"

# CIDR covering the whole internal switch subnet (used for routing rules).
SWITCH_SUBNET="192.168.0.0/16"

# Name of the Linux network namespace used to isolate the NAT logic.
NS_NAME="ns1"

# veth pair – internet side (connects main-namespace to ns1 toward eno1).
VETH_INTERNET_HOST="veth6"          # lives in the main namespace
VETH_INTERNET_NS="veth5"            # lives inside NS_NAME

# veth pair – switch side (connects main-namespace to ns1 toward eno2 traffic).
VETH_SWITCH_HOST="veth4"            # lives in the main namespace
VETH_SWITCH_NS="veth3"              # lives inside NS_NAME

# IP addresses for the veth pairs (pick /30 blocks that don't conflict with
# anything already on your server).
VETH_INTERNET_HOST_IP="172.16.3.2/30"
VETH_INTERNET_NS_IP="172.16.3.1/30"
VETH_SWITCH_HOST_IP="192.16.4.2/30"
VETH_SWITCH_NS_IP="172.16.4.1/30"

# Policy-routing table used to steer downstream traffic into the NAT namespace.
# The name must be unique in /etc/iproute2/rt_tables; the ID must be 1–252.
POLICY_TABLE_NAME="netreplica_rt"
POLICY_TABLE_ID="300"

# Subnet whose traffic is subject to policy routing (GRE inner addresses).
GRE_CLIENT_SUBNET="192.168.99.0/24"

# IP of the downstream server's switch-facing interface (next-hop back to clients).
DOWNSTREAM_SWITCH_IP="192.168.1.203"


# -----------------------------------------------------------------------------
# DOWNSTREAM SERVER  (Core Router / Aggregator)
# Role: Terminates GRE tunnels from Pinot/client nodes, routes traffic toward
#       LibreQoS → upstream server.
# -----------------------------------------------------------------------------

# Network interface on the downstream server connected to the switch.
DOWNSTREAM_SWITCH_IFACE="ens2f1"

# Network interface on the downstream server connected to the internet
# (used as the local GRE endpoint; may be the same physical port as management).
DOWNSTREAM_INTERNET_IFACE="eno1"

# IP address assigned to DOWNSTREAM_SWITCH_IFACE.
DOWNSTREAM_SWITCH_IP="192.168.1.203"

# Public IP of this server – used as the local end of each GRE tunnel.
SERVER_INTERNET_IP="128.111.5.236"

# Public IP of the remote Pinot node / client that will be the GRE peer.
# For multiple clients, this script creates one tunnel per client; list them
# space-separated: PINOT_IPS="1.2.3.4 5.6.7.8"
PINOT_IPS="169.231.171.58"

# Base /30 block for GRE tunnel addressing.
# The script increments this per tunnel: .1/30, .5/30, .9/30, …
# First address = network, second = server end, third = client end, fourth = broadcast.
GRE_TUNNEL_BASE="192.168.99"

# Name prefix for GRE tunnel interfaces (suffixed with 1, 2, 3 …).
GRE_TUNNEL_PREFIX="gre"

# Docker network for netReplica containers.
DOCKER_NETWORK_NAME="docBr"
DOCKER_SUBNET="192.168.40.0/24"
DOCKER_MTU="1470"          # reduced from 1500 to account for GRE overhead


# -----------------------------------------------------------------------------
# LIBREQOS SERVER  (Traffic Shaper – "on-a-stick" VLAN mode)
# Role: Sits between upstream and downstream VLANs on the switch and applies
#       per-subscriber bandwidth policies via XDP.
# -----------------------------------------------------------------------------

# Network interface on the LibreQoS server connected to the switch trunk port.
LIBREQOS_SWITCH_IFACE="enp216s0f0"

# Network interface used for management / dashboard access.
LIBREQOS_MGMT_IFACE="eno1"

# IP address for the sub-interface facing the UPSTREAM VLAN.
LIBREQOS_VLAN_UPSTREAM_IP="192.168.0.200/24"

# IP address for the sub-interface facing the DOWNSTREAM VLAN.
LIBREQOS_VLAN_DOWNSTREAM_IP="192.168.1.200/24"

# LibreQoS configuration file paths (defaults after a standard install).
LIBREQOS_ISP_CONFIG="/opt/libreqos/src/ispConfig.py"
LIBREQOS_LQOS_CONF="/etc/lqos.conf"


# -----------------------------------------------------------------------------
# SWITCH  (Managed L2 switch connecting all three servers)
# -----------------------------------------------------------------------------

# Serial console device on the server that is physically attached to the switch
# management port (typically the downstream server).
SWITCH_SERIAL_DEVICE="/dev/ttyUSB0"

# Switch interface (port) cabled to the UPSTREAM server.
SWITCH_UPSTREAM_PORT="te1/0/3"

# Switch interface (port) cabled to the DOWNSTREAM server.
SWITCH_DOWNSTREAM_PORT="te1/0/4"

# Switch interface (port) cabled to the LIBREQOS server (must be trunk).
SWITCH_LIBREQOS_PORT="te1/0/1"

# VLAN IDs used to segregate upstream and downstream traffic.
VLAN_UPSTREAM_ID="22"
VLAN_DOWNSTREAM_ID="11"
